# Set these in the process environment. The Python pipeline does not read .env files.
# Set the public dashboard URL when it is assigned.
DASHBOARD_URL=

# Optional Gemini credential. Use a GitHub Actions secret for workflow runs.
GEMINI_API_KEY=

# Optional webhook credential for a local run with persistent, private storage.
WEBHOOK_URL=
# GOOGLE_CHAT_WEBHOOK_URL and SLACK_WEBHOOK_URL are also accepted as fallbacks.
# Optional directory outside the checkout. Defaults to ~/.uk-retail-threat-intel.
NOTIFICATION_STATE_DIR=
